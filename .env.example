# PostgreSQL local
DB_NAME=citafin
DB_USERNAME=citafin
DB_PASSWORD=citafin_local
DB_PORT=5432

# Mailpit local
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
MAILPIT_MAX_MESSAGES=500

# Identity URLs and browser policy
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
SECURE_COOKIES=false

# SMTP adapter (Mailpit defaults for local development)
MAIL_HOST=localhost
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-reply@citafin.local

# Generate independent Base64 secrets of at least 32 random bytes before enabling JWT or MFA.
JWT_HMAC_SECRET=
MFA_ENCRYPTION_KEY=
